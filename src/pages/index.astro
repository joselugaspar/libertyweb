---
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import HouseDirectory from "../components/HouseDirectory.astro";
import WorkShowcase from "../components/WorkShowcase.astro";
import StudioStory from "../components/StudioStory.astro";
import VisitBooking from "../components/VisitBooking.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FloatingInstagram from "../components/FloatingInstagram.astro";
import "../styles/redesign.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Liberty Tattoo Córdoba. Tatuaje tradicional, blackwork y diseños personalizados en el centro de Córdoba." />
    <meta name="theme-color" content="#172126" />
    <link rel="icon" type="image/svg+xml" href="/liberty-mark.svg" />
    <title>Liberty Tattoo — Córdoba</title>
  </head>
  <body>
    <SiteHeader />
    <main>
      <Hero />
      <HouseDirectory />
      <WorkShowcase />
      <StudioStory />
      <VisitBooking />
    </main>
    <SiteFooter />
    <FloatingInstagram />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
