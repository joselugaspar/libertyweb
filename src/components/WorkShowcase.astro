---
const instagram = "https://www.instagram.com/libertytattoo.cordoba/";
const works = [
  { src: "/assets/tattoo-flowers.jpg", width: 640, height: 640, alt: "Tatuaje blackwork de flores realizado en Liberty Tattoo", index: "01", title: "Flores", style: "Blackwork" },
  { src: "/assets/tattoo-skull.jpg", width: 559, height: 640, alt: "Tatuaje tradicional de una calavera con detalles rojos", index: "02", title: "Calavera", style: "Tradicional" },
  { src: "/assets/tattoo-eagle.jpg", width: 622, height: 640, alt: "Tatuaje tradicional de un águila", index: "03", title: "Águila", style: "Tradicional" },
];
---

<section class="work" id="trabajos" aria-labelledby="work-title">
  <header class="work__head">
    <p class="section-kicker" data-reveal>Selección reciente</p>
    <h2 id="work-title" data-reveal>Hecho en<br />Liberty.</h2>
    <a class="type-link" href={instagram} target="_blank" rel="noreferrer" data-reveal>Ver el archivo completo</a>
  </header>
  <div class="work__list">
    {works.map((work, index) => (
      <figure class="work-piece" data-reveal style={`--delay: ${index * 80}ms`}>
        <a href={instagram} target="_blank" rel="noreferrer" aria-label={`Ver ${work.title} en Instagram`}>
          <span class="work-piece__image"><img src={work.src} width={work.width} height={work.height} alt={work.alt} loading="lazy" /></span>
          <figcaption><span>{work.index}</span><strong>{work.title}</strong><span>{work.style}</span></figcaption>
        </a>
      </figure>
    ))}
  </div>
</section>
