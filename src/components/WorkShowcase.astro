---
const works = ["01", "02", "03", "04", "05"];
---

<section class="work" id="trabajos" aria-labelledby="work-title" data-zone-reveal data-work-carousel>
  <header class="work__head">
    <p class="section-kicker" data-reveal>03 · Galería</p>
    <h2 id="work-title" data-reveal>Hecho en Liberty.</h2>
    <div class="work__controls" data-reveal>
      <button type="button" data-work-prev>Anterior</button>
      <p aria-live="polite"><span data-work-current>01</span> / {String(works.length).padStart(2, "0")}</p>
      <button type="button" data-work-next>Siguiente</button>
    </div>
  </header>
  <div class="work__viewport" data-work-viewport tabindex="0" aria-label="Próximos trabajos de Liberty Tattoo">
    <div class="work__track">
      {works.map((index) => (
        <article class="work-slide" data-work-slide>
          <span>{index}</span>
          <strong>Próximamente</strong>
          <p>Nuevo trabajo en preparación.</p>
        </article>
      ))}
    </div>
  </div>
</section>
